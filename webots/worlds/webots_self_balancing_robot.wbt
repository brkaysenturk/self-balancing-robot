#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"

WorldInfo {
  basicTimeStep 10
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "wheel_rubber"
      material2 "default"
      coulombFriction [
        1.8
      ]
      bounce 0.05
    }
    ContactProperties {
      material1 "medicine_box"
      material2 "default"
      coulombFriction [
        0.5
      ]
      bounce 0.02
    }
    ContactProperties {
      material1 "default"
      material2 "dock_guide"
      coulombFriction [
        0.02
      ]
      bounce 0.01
    }
  ]
}

Viewpoint {
  orientation -0.15 0.15 0.98 1.85
  position 0.65 -1.35 0.65
  follow "cdtp_balance_robot"
  followType "Tracking Shot"
}

TexturedBackground {
}

TexturedBackgroundLight {
}

RectangleArena {
  floorSize 4.0 4.0
  floorAppearance PBRAppearance {
    baseColor 0.36 0.38 0.41
    roughness 0.55
    metalness 0.05
  }
  wallHeight 0.85
  wallAppearance PBRAppearance {
    baseColor 0.72 0.74 0.77
    roughness 0.65
    metalness 0.0
  }
}

DEF cdtp_balance_robot Robot {
  translation 0 0 0.0425
  rotation 0 0 1 0
  supervisor TRUE
  children [
    # ========================================================
    # SENSÖRLER (IMU, Jiroskop, İvmeölçer - Katman 3 Merkezinde)
    # ========================================================
    InertialUnit {
      name "imu"
      translation 0 0 0.083
    }
    Gyro {
      name "gyro"
      translation 0 0 0.083
    }
    Accelerometer {
      name "accel"
      translation 0 0 0.083
    }

    # ========================================================
    # SOL TEKERLEK & MOTOR (85 mm Silikon Tekerlek + Enkoder)
    # ========================================================
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor -0.085 0 0
      }
      device [
        RotationalMotor {
          name "left_motor"
          maxVelocity 35.0
          maxTorque 3.0
        }
        PositionSensor {
          name "left_encoder"
        }
      ]
      endPoint DEF pid_left_wheel Solid {
        name "left_wheel"
        translation -0.085 0 0
        rotation 0 1 0 1.57079632679
        children [
          DEF WHEEL_LEFT Shape {
            appearance PBRAppearance {
              baseColor 0.15 0.15 0.15
              roughness 0.7
              metalness 0.1
            }
            geometry Cylinder {
              height 0.035
              radius 0.0425
            }
          }
          DEF WHEEL_RIM_LEFT Shape {
            appearance PBRAppearance {
              baseColor 0.8 0.15 0.15
              roughness 0.3
              metalness 0.8
            }
            geometry Cylinder {
              height 0.036
              radius 0.024
            }
          }
        ]
        contactMaterial "wheel_rubber"
        boundingObject USE WHEEL_LEFT
        physics Physics {
          density -1
          mass 0.07
        }
      }
    }

    # ========================================================
    # SAĞ TEKERLEK & MOTOR (85 mm Silikon Tekerlek + Enkoder)
    # ========================================================
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor 0.085 0 0
      }
      device [
        RotationalMotor {
          name "right_motor"
          maxVelocity 35.0
          maxTorque 3.0
        }
        PositionSensor {
          name "right_encoder"
        }
      ]
      endPoint DEF pid_right_wheel Solid {
        name "right_wheel"
        translation 0.085 0 0
        rotation 0 1 0 1.57079632679
        children [
          DEF WHEEL_RIGHT Shape {
            appearance PBRAppearance {
              baseColor 0.15 0.15 0.15
              roughness 0.7
              metalness 0.1
            }
            geometry Cylinder {
              height 0.035
              radius 0.0425
            }
          }
          DEF WHEEL_RIM_RIGHT Shape {
            appearance PBRAppearance {
              baseColor 0.8 0.15 0.15
              roughness 0.3
              metalness 0.8
            }
            geometry Cylinder {
              height 0.036
              radius 0.024
            }
          }
        ]
        contactMaterial "wheel_rubber"
        boundingObject USE WHEEL_RIGHT
        physics Physics {
          density -1
          mass 0.07
        }
      }
    }

    # ========================================================
    # 4 KATMANLI ŞASİ PLAKALARI (135 mm × 95 mm × 5 mm Beyaz Dekota)
    # ========================================================
    # Katman 1: Taban (Base Deck)
    Transform {
      translation 0 0 0.008
      children [
        DEF DECK_SHAPE Shape {
          appearance DEF WHITE_DEKOTA PBRAppearance {
            baseColor 0.95 0.95 0.96
            roughness 0.25
            metalness 0.0
          }
          geometry Box {
            size 0.135 0.095 0.005
          }
        }
      ]
    }

    # Katman 2: Güç & Batarya Katmanı (Power Deck)
    Transform {
      translation 0 0 0.043
      children [
        USE DECK_SHAPE
      ]
    }

    # Katman 3: Kontrol & Beyin Katmanı (Brain Deck)
    Transform {
      translation 0 0 0.083
      children [
        USE DECK_SHAPE
      ]
    }

    # Katman 4: Tavan & İlaç Taşıma Katmanı (Top Deck)
    Transform {
      translation 0 0 0.123
      children [
        USE DECK_SHAPE
      ]
    }

    # ========================================================
    # 4 ADET M3 PASLANMAZ ÇELİK TİJ (KAFES KOLONLARI)
    # ========================================================
    # Ön-Sağ Tij Kolonu
    Transform {
      translation 0.0615 0.0415 0.0655
      rotation 0 0 1 0
      children [
        DEF TIJ_ROD Shape {
          appearance DEF STEEL_ROD PBRAppearance {
            baseColor 0.82 0.84 0.87
            roughness 0.2
            metalness 0.95
          }
          geometry Cylinder {
            height 0.122
            radius 0.0016
          }
        }
      ]
    }
    # Ön-Sol Tij Kolonu
    Transform {
      translation -0.0615 0.0415 0.0655
      rotation 0 0 1 0
      children [
        USE TIJ_ROD
      ]
    }
    # Arka-Sağ Tij Kolonu
    Transform {
      translation 0.0615 -0.0415 0.0655
      rotation 0 0 1 0
      children [
        USE TIJ_ROD
      ]
    }
    # Arka-Sol Tij Kolonu
    Transform {
      translation -0.0615 -0.0415 0.0655
      rotation 0 0 1 0
      children [
        USE TIJ_ROD
      ]
    }

    # ========================================================
    # İÇ BİLEŞENLER & DONANIMLAR
    # ========================================================
    # 2x JGB37-520 Redüktörlü Metal Motor Gövdeleri
    Transform {
      translation -0.045 0 0
      rotation 0 1 0 1.57079632679
      children [
        DEF MOTOR_BODY Shape {
          appearance DEF MOTOR_METAL PBRAppearance {
            baseColor 0.65 0.68 0.72
            roughness 0.35
            metalness 0.85
          }
          geometry Cylinder {
            height 0.052
            radius 0.0185
          }
        }
      ]
    }
    Transform {
      translation 0.045 0 0
      rotation 0 1 0 1.57079632679
      children [
        USE MOTOR_BODY
      ]
    }

    # TB6612FNG Sürücü (Katman 1 Tabanında)
    Transform {
      translation 0 -0.018 0.013
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.85 0.1 0.1
            roughness 0.4
          }
          geometry Box {
            size 0.022 0.022 0.005
          }
        }
      ]
    }

    # 3S 18650 Li-ion Batarya Paketi (Katman 2 Üzerinde - Ağırlık Merkezi CoM=10cm)
    Transform {
      translation 0 0 0.056
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.35 0.85
            roughness 0.35
            metalness 0.1
          }
          geometry Box {
            size 0.065 0.055 0.020
          }
        }
      ]
    }

    # ESP32 DevKit V1 (Katman 3 Üzerinde)
    Transform {
      translation 0 -0.015 0.090
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.12
            roughness 0.3
          }
          geometry Box {
            size 0.052 0.028 0.006
          }
        }
      ]
    }

    # MPU-6050 Sensör Modülü (Katman 3 Merkezinde X=0, Y=0)
    Transform {
      translation 0 0.015 0.088
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.25 0.5
            roughness 0.3
          }
          geometry Box {
            size 0.020 0.015 0.004
          }
        }
      ]
    }

    # 2x TSSP4038 / TSOP38438 38 kHz IR Alıcı Gözleri (Katman 3 Ön Kenar, 85 mm Aralıklı: X = +/- 0.0425 m)
    Transform {
      translation -0.0425 0.0475 0.088
      children [
        DEF TSOP_RECEIVER_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.10
            roughness 0.2
            metalness 0.3
          }
          geometry Box {
            size 0.006 0.005 0.007
          }
        }
      ]
    }
    Transform {
      translation 0.0425 0.0475 0.088
      children [
        USE TSOP_RECEIVER_SHAPE
      ]
    }

    # TCRT5000 Kızılötesi Yakınlık / Duruş Sensörü (Katman 1 Ön Tampon Merkezi, X = 0, Y = 0.0475 m)
    Transform {
      translation 0 0.0475 0.014
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.28 0.75
            roughness 0.35
          }
          geometry Box {
            size 0.014 0.006 0.008
          }
        }
      ]
    }

    # Katman 4 Aspirin / Parol Kaset Yuvası Çerçevesi (Holster Rim)
    Transform {
      translation 0 0.014 0.1355
      children [
        DEF HOLSTER_WALL_X Shape {
          appearance USE WHITE_DEKOTA
          geometry Box {
            size 0.082 0.004 0.020
          }
        }
      ]
    }
    Transform {
      translation 0 -0.014 0.1355
      children [
        USE HOLSTER_WALL_X
      ]
    }
    Transform {
      translation -0.040 0 0.1355
      children [
        DEF HOLSTER_WALL_Y Shape {
          appearance USE WHITE_DEKOTA
          geometry Box {
            size 0.004 0.026 0.020
          }
        }
      ]
    }
    Transform {
      translation 0.040 0 0.1355
      children [
        USE HOLSTER_WALL_Y
      ]
    }

    # KCD11 Güç Switchi (Kırmızı Rocker Switch)
    Transform {
      translation -0.035 -0.030 0.130
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.15 0.1
            roughness 0.2
          }
          geometry Box {
            size 0.019 0.013 0.008
          }
        }
      ]
    }

    # 3A Cam Sigorta Yuvası Kapağı
    Transform {
      translation 0.035 -0.030 0.130
      rotation 0 0 1 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
            roughness 0.6
          }
          geometry Cylinder {
            height 0.008
            radius 0.006
          }
        }
      ]
    }

    # Durum/Yanaşma LEDi (Normalde Sönük, Yanaşmada Sarı, İstasyona Oturduğunda Parlak Yeşil)
    Transform {
      translation 0 0.035 0.129
      children [
        Shape {
          appearance DEF STATUS_LED_MAT PBRAppearance {
            baseColor 0.22 0.25 0.28
            emissiveColor 0.0 0.0 0.0
          }
          geometry Sphere {
            radius 0.0045
          }
        }
      ]
    }
  ]

  # Gövde Çarpışma Hacmi (BoundingObject)
  boundingObject Group {
    children [
      Transform {
        translation 0 0 0.065
        children [
          Box {
            size 0.120 0.095 0.120
          }
        ]
      }
      # Katman 4 İlaç Yuvası Çerçeve Duvarları (Bounding)
      Transform {
        translation 0 0.014 0.1355
        children [
          Box {
            size 0.082 0.004 0.020
          }
        ]
      }
      Transform {
        translation 0 -0.014 0.1355
        children [
          Box {
            size 0.082 0.004 0.020
          }
        ]
      }
      Transform {
        translation -0.040 0 0.1355
        children [
          Box {
            size 0.004 0.026 0.020
          }
        ]
      }
      Transform {
        translation 0.040 0 0.1355
        children [
          Box {
            size 0.004 0.026 0.020
          }
        ]
      }
    ]
  }

  physics Physics {
    density -1
    mass 0.72
    centerOfMass [
      0 0 0.055
    ]
  }

  controller "webots_main"
}

# ========================================================
# AYRIK FİZİKSEL İLAÇ KUTUSU (Standart Aspirin - Modül E)
# ========================================================
DEF aspirin_box Solid {
  translation 0 0 0.180
  children [
    DEF ASPIRIN_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.72 0.35
        roughness 0.35
        metalness 0.05
      }
      geometry Box {
        size 0.074 0.020 0.024
      }
    }
  ]
  name "aspirin_box"
  contactMaterial "medicine_box"
  boundingObject USE ASPIRIN_SHAPE
  physics Physics {
    density -1
    mass 0.025
  }
}

# ========================================================
# 38 kHz IR VERİCİ FENERİ & HUNİ KILAVUZLU YANAŞMA İSTASYONU (MODÜL C)
# ========================================================
# Robot şasi genişliği: 135 mm (X = +/- 67.5 mm), ön tampon Y = +47.5 mm.
# Huni kılavuz kolları: Tekerleklerin üstünden (Z = 112 mm, Katman 3-4 hizası)
# 210 mm genişlikten (X = +/- 105 mm) başlayıp 24 derece açıyla daralarak arkada
# 142 mm (135 mm şasi + 7 mm tolerans, X = +/- 71 mm) yuvaya oturur.
# Böylece dönen kauçuk tekerlekler yan duvarlara sürtünüp tırmanmaz; yalnız pürüzsüz
# üst Dekota şasi plakaları huni kılavuzlarından kayarak merkeze tam oturur.
DEF ir_dock_station Solid {
  translation 0 1.45 0
  children [
    # İstasyon Taban Plakası (280 mm × 200 mm)
    Transform {
      translation 0 -0.030 0.003
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.22 0.24 0.28
            roughness 0.4
            metalness 0.2
          }
          geometry Box {
            size 0.280 0.200 0.006
          }
        }
      ]
    }
    # İstasyon Arka Kule Gövdesi (Robot +Y yönünde yaklaşırken duracağı hedef yüzey)
    Transform {
      translation 0 0.045 0.080
      children [
        DEF DOCK_BACK_WALL Shape {
          appearance PBRAppearance {
            baseColor 0.92 0.93 0.95
            roughness 0.3
            metalness 0.05
          }
          geometry Box {
            size 0.240 0.030 0.155
          }
        }
      ]
    }
    # Sol ve Sağ Taşıyıcı Yan Dikmeler (Tekerleklerin Dışında: X = +/- 0.115 m)
    Transform {
      translation -0.115 -0.025 0.060
      children [
        DEF DOCK_PILLAR Shape {
          appearance PBRAppearance {
            baseColor 0.22 0.24 0.28
            roughness 0.4
            metalness 0.2
          }
          geometry Box {
            size 0.012 0.025 0.115
          }
        }
      ]
    }
    Transform {
      translation 0.115 -0.025 0.060
      children [
        USE DOCK_PILLAR
      ]
    }
    # Sol Daralan Şasi Huni Kılavuzu (Genişten Dara: 230 mm -> 144 mm, Z = 112 mm Şasi Hizası)
    Transform {
      translation -0.0935 -0.044 0.112
      rotation 0 0 1 -0.401425728
      children [
        DEF DOCK_GUIDE_RAIL Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.48 0.82
            roughness 0.15
            metalness 0.1
          }
          geometry Box {
            size 0.008 0.115 0.032
          }
        }
      ]
    }
    # Sağ Daralan Şasi Huni Kılavuzu (Genişten Dara: 230 mm -> 144 mm, Z = 112 mm Şasi Hizası)
    Transform {
      translation 0.0935 -0.044 0.112
      rotation 0 0 1 0.401425728
      children [
        USE DOCK_GUIDE_RAIL
      ]
    }
    # Sol ve Sağ Arka Düz Yuva Yan Kılavuzları (144 mm İç Genişlik = 135 mm Şasi + 9 mm Pay)
    Transform {
      translation -0.075 0.015 0.112
      children [
        DEF DOCK_STRAIGHT_RAIL Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.48 0.82
            roughness 0.15
            metalness 0.1
          }
          geometry Box {
            size 0.008 0.030 0.032
          }
        }
      ]
    }
    Transform {
      translation 0.075 0.015 0.112
      children [
        USE DOCK_STRAIGHT_RAIL
      ]
    }
    # 38 kHz Kızılötesi (IR) Verici Feneri (Katman 3 IR Alıcı Hizasında Z = 0.130 m)
    DEF ir_beacon_emitter Transform {
      translation 0 0.012 0.130
      rotation 1 0 0 1.57079632679
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.10 0.25
            emissiveColor 0.85 0.05 0.15
            roughness 0.15
          }
          geometry Cylinder {
            height 0.010
            radius 0.008
          }
        }
      ]
    }
    # 30 cm Yarıçaplı Yaklaşma Bölgesi Zemin İşaretçisi (Görsel Kılavuz Halkası)
    Transform {
      translation 0 -0.14 0.001
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.55 0.85
            transparency 0.72
            roughness 0.6
          }
          geometry Cylinder {
            height 0.002
            radius 0.30
          }
        }
      ]
    }
  ]
  name "ir_dock_station"
  contactMaterial "dock_guide"
  boundingObject Group {
    children [
      Transform {
        translation 0 0.045 0.080
        children [
          Box {
            size 0.240 0.030 0.155
          }
        ]
      }
      Transform {
        translation -0.0935 -0.044 0.112
        rotation 0 0 1 -0.401425728
        children [
          Box {
            size 0.008 0.115 0.032
          }
        ]
      }
      Transform {
        translation 0.0935 -0.044 0.112
        rotation 0 0 1 0.401425728
        children [
          Box {
            size 0.008 0.115 0.032
          }
        ]
      }
      Transform {
        translation -0.075 0.015 0.112
        children [
          Box {
            size 0.008 0.030 0.032
          }
        ]
      }
      Transform {
        translation 0.075 0.015 0.112
        children [
          Box {
            size 0.008 0.030 0.032
          }
        ]
      }
    ]
  }
}
