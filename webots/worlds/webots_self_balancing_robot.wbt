#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"

WorldInfo {
  basicTimeStep 10
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "wheel_rubber"
      material2 "default"
      coulombFriction [
        1.8
      ]
      bounce 0.05
    }
    ContactProperties {
      material1 "medicine_box"
      material2 "default"
      coulombFriction [
        0.5
      ]
      bounce 0.02
    }
    ContactProperties {
      material1 "default"
      material2 "dock_guide"
      coulombFriction [
        0.02
      ]
      bounce 0.01
    }
  ]
}

Viewpoint {
  orientation -0.15 0.15 0.98 1.85
  position 0.65 -1.35 0.65
  follow "cdtp_balance_robot"
  followType "Tracking Shot"
}

TexturedBackground {
}

TexturedBackgroundLight {
}

RectangleArena {
  floorSize 4.0 4.0
  floorAppearance PBRAppearance {
    baseColor 0.36 0.38 0.41
    roughness 0.55
    metalness 0.05
  }
  wallHeight 0.85
  wallAppearance PBRAppearance {
    baseColor 0.72 0.74 0.77
    roughness 0.65
    metalness 0.0
  }
}

DEF cdtp_balance_robot Robot {
  translation 0 0 0.0425
  rotation 0 0 1 0
  supervisor TRUE
  children [
    # ========================================================
    # SENSÖRLER (IMU, Jiroskop, İvmeölçer - Katman 3 Merkezinde)
    # ========================================================
    InertialUnit {
      name "imu"
      translation 0 0 0.083
    }
    Gyro {
      name "gyro"
      translation 0 0 0.083
    }
    Accelerometer {
      name "accel"
      translation 0 0 0.083
    }

    # ========================================================
    # WEBOTS MODELLENMİŞ SENSÖRLER (2x TSOP2238 IR Alıcı & TCRT5000)
    # ========================================================
    Receiver {
      name "tsop_left"
      translation -0.0425 0.050 0.088
      rotation 0 0 1 0.2618
      type "infra-red"
      aperture 2.0944
      channel 1
    }
    Receiver {
      name "tsop_right"
      translation 0.0425 0.050 0.088
      rotation 0 0 1 -0.2618
      type "infra-red"
      aperture 2.0944
      channel 1
    }
    DistanceSensor {
      name "tcrt5000"
      translation 0 0.050 0.014
      rotation 0 0 1 1.57079632679
      type "infra-red"
      numberOfRays 1
      aperture 0.1
      lookupTable [
        0 4095 0
        0.005 3500 0.01
        0.015 2000 0.02
        0.030 500 0.03
        0.060 0 0
      ]
    }

    # ========================================================
    # SOL TEKERLEK & MOTOR (85 mm Silikon Tekerlek + Enkoder)
    # ========================================================
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor -0.095 0 0
      }
      device [
        RotationalMotor {
          name "left_motor"
          maxVelocity 35.0
          maxTorque 3.0
        }
        PositionSensor {
          name "left_encoder"
        }
      ]
      endPoint DEF pid_left_wheel Solid {
        name "left_wheel"
        translation -0.095 0 0
        rotation 0 1 0 1.57079632679
        children [
          DEF WHEEL_LEFT Shape {
            appearance PBRAppearance {
              baseColor 0.15 0.15 0.15
              roughness 0.7
              metalness 0.1
            }
            geometry Cylinder {
              height 0.035
              radius 0.0425
            }
          }
          DEF WHEEL_RIM_LEFT Shape {
            appearance PBRAppearance {
              baseColor 0.8 0.15 0.15
              roughness 0.3
              metalness 0.8
            }
            geometry Cylinder {
              height 0.036
              radius 0.024
            }
          }
        ]
        contactMaterial "wheel_rubber"
        boundingObject USE WHEEL_LEFT
        physics Physics {
          density -1
          mass 0.07
        }
      }
    }

    # ========================================================
    # SAĞ TEKERLEK & MOTOR (85 mm Silikon Tekerlek + Enkoder)
    # ========================================================
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor 0.095 0 0
      }
      device [
        RotationalMotor {
          name "right_motor"
          maxVelocity 35.0
          maxTorque 3.0
        }
        PositionSensor {
          name "right_encoder"
        }
      ]
      endPoint DEF pid_right_wheel Solid {
        name "right_wheel"
        translation 0.095 0 0
        rotation 0 1 0 1.57079632679
        children [
          DEF WHEEL_RIGHT Shape {
            appearance PBRAppearance {
              baseColor 0.15 0.15 0.15
              roughness 0.7
              metalness 0.1
            }
            geometry Cylinder {
              height 0.035
              radius 0.0425
            }
          }
          DEF WHEEL_RIM_RIGHT Shape {
            appearance PBRAppearance {
              baseColor 0.8 0.15 0.15
              roughness 0.3
              metalness 0.8
            }
            geometry Cylinder {
              height 0.036
              radius 0.024
            }
          }
        ]
        contactMaterial "wheel_rubber"
        boundingObject USE WHEEL_RIGHT
        physics Physics {
          density -1
          mass 0.07
        }
      }
    }

    # ========================================================
    # 4 KATMANLI ŞASİ PLAKALARI (150 mm × 100 mm × 5 mm Beyaz Dekota)
    # ========================================================
    # Katman 1: Taban (Base Deck)
    Transform {
      translation 0 0 0.008
      children [
        DEF DECK_SHAPE Shape {
          appearance DEF WHITE_DEKOTA PBRAppearance {
            baseColor 0.95 0.95 0.96
            roughness 0.25
            metalness 0.0
          }
          geometry Box {
            size 0.150 0.100 0.005
          }
        }
      ]
    }

    # Katman 2: Güç & Batarya Katmanı (Power Deck)
    Transform {
      translation 0 0 0.043
      children [
        USE DECK_SHAPE
      ]
    }

    # Katman 3: Kontrol & Beyin Katmanı (Brain Deck)
    Transform {
      translation 0 0 0.083
      children [
        USE DECK_SHAPE
      ]
    }

    # Katman 4: Tavan & İlaç Taşıma Katmanı (Top Deck)
    Transform {
      translation 0 0 0.123
      children [
        USE DECK_SHAPE
      ]
    }

    # ========================================================
    # 4 ADET M3 PASLANMAZ ÇELİK TİJ (KAFES KOLONLARI)
    # ========================================================
    # Ön-Sağ Tij Kolonu (150x100 mm: X=+69mm, Y=+44mm)
    Transform {
      translation 0.069 0.044 0.0655
      rotation 0 0 1 0
      children [
        DEF TIJ_ROD Shape {
          appearance DEF STEEL_ROD PBRAppearance {
            baseColor 0.82 0.84 0.87
            roughness 0.2
            metalness 0.95
          }
          geometry Cylinder {
            height 0.122
            radius 0.0016
          }
        }
      ]
    }
    # Ön-Sol Tij Kolonu (X=-69mm, Y=+44mm)
    Transform {
      translation -0.069 0.044 0.0655
      rotation 0 0 1 0
      children [
        USE TIJ_ROD
      ]
    }
    # Arka-Sağ Tij Kolonu (X=+69mm, Y=-44mm)
    Transform {
      translation 0.069 -0.044 0.0655
      rotation 0 0 1 0
      children [
        USE TIJ_ROD
      ]
    }
    # Arka-Sol Tij Kolonu (X=-69mm, Y=-44mm)
    Transform {
      translation -0.069 -0.044 0.0655
      rotation 0 0 1 0
      children [
        USE TIJ_ROD
      ]
    }

    # ========================================================
    # İÇ BİLEŞENLER & DONANIMLAR
    # ========================================================
    # 2x JGB37-520 Redüktörlü Metal Motor Gövdeleri
    Transform {
      translation -0.045 0 0
      rotation 0 1 0 1.57079632679
      children [
        DEF MOTOR_BODY Shape {
          appearance DEF MOTOR_METAL PBRAppearance {
            baseColor 0.65 0.68 0.72
            roughness 0.35
            metalness 0.85
          }
          geometry Cylinder {
            height 0.052
            radius 0.0185
          }
        }
      ]
    }
    Transform {
      translation 0.045 0 0
      rotation 0 1 0 1.57079632679
      children [
        USE MOTOR_BODY
      ]
    }

    # TB6612FNG Sürücü (Katman 1 Tabanında - Tam Merkezde)
    Transform {
      translation 0 0 0.013
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.85 0.1 0.1
            roughness 0.4
          }
          geometry Box {
            size 0.022 0.022 0.005
          }
        }
      ]
    }

    # TCRT5000 Kızılötesi Yakınlık / Duruş Sensörü (Katman 1 Ön Tampon Kenarı, X = 0, Y = 0.050 m)
    Transform {
      translation 0 0.050 0.014
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.28 0.75
            roughness 0.35
          }
          geometry Box {
            size 0.014 0.006 0.008
          }
        }
      ]
    }

    # 3S 18650 Li-ion Batarya Paketi (Katman 2 Üzerinde Tam Merkezde - CoM Hizası)
    Transform {
      translation 0 0 0.056
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.35 0.85
            roughness 0.35
            metalness 0.1
          }
          geometry Box {
            size 0.065 0.055 0.020
          }
        }
      ]
    }

    # XL4016 8A Step-Down Regülatör (Katman 2 Sağda, Alüminyum Soğutucu Bloklu)
    Transform {
      translation 0.035 -0.015 0.056
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.60 0.15
            roughness 0.3
            metalness 0.8
          }
          geometry Box {
            size 0.045 0.032 0.018
          }
        }
      ]
    }

    # Mini Güç Dağıtım Kartı (PDB) (Katman 2 Solda, Vidalı Klemensli Pertinaks)
    Transform {
      translation -0.035 -0.015 0.052
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.35 0.15 0.55
            roughness 0.4
          }
          geometry Box {
            size 0.035 0.030 0.010
          }
        }
      ]
    }

    # KCD11 Güç Switchi (Katman 2 Arka Sol Köşede - Kolay Ulaşılabilir)
    Transform {
      translation -0.055 -0.032 0.054
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.15 0.1
            roughness 0.2
          }
          geometry Box {
            size 0.019 0.013 0.012
          }
        }
      ]
    }

    # 3A Cam Sigorta Yuvası Kapağı (Katman 2 Arka Sağ Köşede)
    Transform {
      translation 0.055 -0.032 0.054
      rotation 0 0 1 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
            roughness 0.6
          }
          geometry Cylinder {
            height 0.012
            radius 0.006
          }
        }
      ]
    }

    # ESP32 38-Pin Vidalı Terminal Shield & ESP32-WROOM (Katman 3 Ön Bölge)
    Transform {
      translation 0 0.022 0.092
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.10 0.45 0.40
            roughness 0.35
          }
          geometry Box {
            size 0.065 0.038 0.012
          }
        }
      ]
    }

    # MPU-6050 Sensör Modülü (Katman 3 Geometrik Merkezinde X=0, Y=0)
    Transform {
      translation 0 0 0.088
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.25 0.5
            roughness 0.3
          }
          geometry Box {
            size 0.020 0.015 0.004
          }
        }
      ]
    }

    # 2x TSSP4038 / TSOP38438 38 kHz IR Alıcı Gözleri (Katman 3 Ön Kenar Y=0.050m, 85 mm Aralıklı: X = +/- 0.0425 m)
    Transform {
      translation -0.0425 0.050 0.088
      children [
        DEF TSOP_RECEIVER_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.10
            roughness 0.2
            metalness 0.3
          }
          geometry Box {
            size 0.006 0.005 0.007
          }
        }
      ]
    }
    Transform {
      translation 0.0425 0.050 0.088
      children [
        USE TSOP_RECEIVER_SHAPE
      ]
    }

    # Katman 4 Aspirin / Parol Kaset Yuvası Çerçevesi (Holster Rim - 80 × 26 mm)
    Transform {
      translation 0 0.015 0.1355
      children [
        DEF HOLSTER_WALL_X Shape {
          appearance USE WHITE_DEKOTA
          geometry Box {
            size 0.088 0.004 0.020
          }
        }
      ]
    }
    Transform {
      translation 0 -0.015 0.1355
      children [
        USE HOLSTER_WALL_X
      ]
    }
    Transform {
      translation -0.042 0 0.1355
      children [
        DEF HOLSTER_WALL_Y Shape {
          appearance USE WHITE_DEKOTA
          geometry Box {
            size 0.004 0.026 0.020
          }
        }
      ]
    }
    Transform {
      translation 0.042 0 0.1355
      children [
        USE HOLSTER_WALL_Y
      ]
    }

    # Durum/Yanaşma LEDi (Katman 4 Ön Kenar Ortası - Normalde Sönük, Yanaşmada Sarı, Şarjda Yeşil)
    Transform {
      translation 0 0.042 0.129
      children [
        Shape {
          appearance DEF STATUS_LED_MAT PBRAppearance {
            baseColor 0.22 0.25 0.28
            emissiveColor 0.0 0.0 0.0
          }
          geometry Sphere {
            radius 0.0045
          }
        }
      ]
    }
  ]

  # Gövde Çarpışma Hacmi (BoundingObject - İki Kademeli: Tekerlek Arası ve Üst Şasi)
  boundingObject Group {
    children [
      # Taban plakasinin gercek 150 mm dis siniri (yan aciklik 2.5 mm)
      Transform {
        translation 0 0 0.008
        children [
          Box {
            size 0.150 0.100 0.005
          }
        ]
      }
      # Alt ic bilesenlerin yaklasik carpisma hacmi
      Transform {
        translation 0 0 0.025
        children [
          Box {
            size 0.120 0.100 0.045
          }
        ]
      }
      # Üst Şasi Bloğu (Katman 2-4: 150 mm Tam Genişlik)
      Transform {
        translation 0 0 0.085
        children [
          Box {
            size 0.150 0.100 0.075
          }
        ]
      }
      # Katman 4 İlaç Yuvası Çerçeve Duvarları (Bounding)
      Transform {
        translation 0 0.015 0.1355
        children [
          Box {
            size 0.088 0.004 0.020
          }
        ]
      }
      Transform {
        translation 0 -0.015 0.1355
        children [
          Box {
            size 0.088 0.004 0.020
          }
        ]
      }
      Transform {
        translation -0.042 0 0.1355
        children [
          Box {
            size 0.004 0.026 0.020
          }
        ]
      }
      Transform {
        translation 0.042 0 0.1355
        children [
          Box {
            size 0.004 0.026 0.020
          }
        ]
      }
    ]
  }

  physics Physics {
    density -1
    mass 0.83
    centerOfMass [
      0 0 0.055
    ]
  }

  controller "webots_main"
}

# ========================================================
# AYRIK FİZİKSEL İLAÇ KUTUSU (Standart Aspirin - Modül E)
# ========================================================
DEF aspirin_box Solid {
  translation 0 0 0.180
  children [
    DEF ASPIRIN_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.72 0.35
        roughness 0.35
        metalness 0.05
      }
      geometry Box {
        size 0.074 0.020 0.024
      }
    }
  ]
  name "aspirin_box"
  contactMaterial "medicine_box"
  boundingObject USE ASPIRIN_SHAPE
  physics Physics {
    density -1
    mass 0.025
  }
}

# ========================================================
# 38 kHz IR VERİCİ FENERİ & HUNİ KILAVUZLU YANAŞMA İSTASYONU (MODÜL C)
# ========================================================
# Robot şasi genişliği: 150 mm (X = +/- 75 mm), ön tampon Y = +50 mm.
# Huni kılavuz kolları: Tekerleklerin üstünden (Z = 112 mm, Katman 3-4 hizası)
# 240 mm genişlikten başlayıp daralarak arkada 162 mm yuvaya oturur (150 mm şasi + 12 mm tolerans).
# Böylece dönen kauçuk tekerlekler yan duvarlara sürtünüp tırmanmaz; yalnız pürüzsüz
# üst Dekota şasi plakaları huni kılavuzlarından kayarak merkeze tam oturur.
DEF ir_dock_station Robot {
  supervisor TRUE
  controller "<none>"
  translation 0 1.45 0
  children [
    # İstasyon Taban Plakası (300 mm × 200 mm)
    Transform {
      translation 0 -0.030 0.003
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.22 0.24 0.28
            roughness 0.4
            metalness 0.2
          }
          geometry Box {
            size 0.300 0.200 0.006
          }
        }
      ]
    }
    # İstasyon Arka Kule Gövdesi (Robot +Y yönünde yaklaşırken duracağı hedef yüzey)
    Transform {
      translation 0 0.045 0.080
      children [
        DEF DOCK_BACK_WALL Shape {
          appearance PBRAppearance {
            baseColor 0.92 0.93 0.95
            roughness 0.3
            metalness 0.05
          }
          geometry Box {
            size 0.280 0.030 0.155
          }
        }
      ]
    }
    # Sol ve Sağ Taşıyıcı Yan Dikmeler (Tekerleklerin Dışında: X = +/- 0.125 m)
    Transform {
      translation -0.125 -0.025 0.060
      children [
        DEF DOCK_PILLAR Shape {
          appearance PBRAppearance {
            baseColor 0.22 0.24 0.28
            roughness 0.4
            metalness 0.2
          }
          geometry Box {
            size 0.012 0.025 0.115
          }
        }
      ]
    }
    Transform {
      translation 0.125 -0.025 0.060
      children [
        USE DOCK_PILLAR
      ]
    }
    # Sol Daralan Şasi Huni Kılavuzu (Genişten Dara: 240 mm -> 162 mm, Z = 112 mm Şasi Hizası)
    Transform {
      translation -0.104 -0.0475 0.112
      rotation 0 0 1 -0.3756
      children [
        DEF DOCK_GUIDE_RAIL Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.48 0.82
            roughness 0.15
            metalness 0.1
          }
          geometry Box {
            size 0.008 0.105 0.032
          }
        }
      ]
    }
    # Sağ Daralan Şasi Huni Kılavuzu (Genişten Dara: 240 mm -> 162 mm, Z = 112 mm Şasi Hizası)
    Transform {
      translation 0.104 -0.0475 0.112
      rotation 0 0 1 0.3756
      children [
        USE DOCK_GUIDE_RAIL
      ]
    }
    # Sol ve Sağ Arka Düz Yuva Yan Kılavuzları (162 mm İç Genişlik = 150 mm Şasi + 12 mm Pay)
    Transform {
      translation -0.085 0.015 0.112
      children [
        DEF DOCK_STRAIGHT_RAIL Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.48 0.82
            roughness 0.15
            metalness 0.1
          }
          geometry Box {
            size 0.008 0.030 0.032
          }
        }
      ]
    }
    Transform {
      translation 0.085 0.015 0.112
      children [
        USE DOCK_STRAIGHT_RAIL
      ]
    }
    # 38 kHz Kızılötesi (IR) Verici Emitter Düğümü (Aktif IR Verici)
    Emitter {
      name "ir_emitter"
      translation 0 0.012 0.130
      rotation 0 0 1 -1.57079632679
      type "infra-red"
      aperture 1.5708
      range 1.0
      channel 1
    }

    # Robot Dayanak / Tampon Bölmesi (Robotun Öne Yaslanma Bölmesi)
    # Robot yanaştığında ön gövdesiyle bu dayanağa yaslanır ve motorlar kapatılır
    Transform {
      translation 0 0.010 0.025
      children [
        DEF DOCK_BUMPER_STOP Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.15 0.18
            roughness 0.6
            metalness 0.1
          }
          geometry Box {
            size 0.140 0.014 0.040
          }
        }
      ]
    }



    # 38 kHz Kızılötesi (IR) Verici Feneri (Katman 3 IR Alıcı Hizasında Z = 0.130 m)
    DEF ir_beacon_emitter Transform {
      translation 0 0.012 0.130
      rotation 1 0 0 1.57079632679
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.10 0.25
            emissiveColor 0.85 0.05 0.15
            roughness 0.15
          }
          geometry Cylinder {
            height 0.010
            radius 0.008
          }
        }
      ]
    }
    # 30 cm Yarıçaplı Yaklaşma Bölgesi Zemin İşaretçisi (Görsel Kılavuz Halkası)
    Transform {
      translation 0 -0.14 0.001
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.55 0.85
            transparency 0.72
            roughness 0.6
          }
          geometry Cylinder {
            height 0.002
            radius 0.30
          }
        }
      ]
    }
  ]
  name "ir_dock_station"
  contactMaterial "dock_guide"
  boundingObject Group {
    children [
      Transform {
        translation 0 0.045 0.080
        children [
          Box {
            size 0.280 0.030 0.155
          }
        ]
      }
      # Robot Dayanak Bölmesi Fiziksel Çarpışma Bloğu
      Transform {
        translation 0 0.010 0.025
        children [
          Box {
            size 0.140 0.014 0.040
          }
        ]
      }

      Transform {
        translation -0.104 -0.0475 0.112
        rotation 0 0 1 -0.3756
        children [
          Box {
            size 0.008 0.105 0.032
          }
        ]
      }
      Transform {
        translation 0.104 -0.0475 0.112
        rotation 0 0 1 0.3756
        children [
          Box {
            size 0.008 0.105 0.032
          }
        ]
      }
      Transform {
        translation -0.085 0.015 0.112
        children [
          Box {
            size 0.008 0.030 0.032
          }
        ]
      }
      Transform {
        translation 0.085 0.015 0.112
        children [
          Box {
            size 0.008 0.030 0.032
          }
        ]
      }
    ]
  }
}
